{
  "name": "@bugsee/react-native",
  "version": "0.0.0",
  "description": "Bugsee SDK for React Native",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://www.bugsee.com",
  "main": "src/index.ts",
  "files": [
    "src",
    "!src/**/__tests__",
    "!src/**/__mocks__",
    "android",
    "!android/src/test",
    "ios",
    "app.plugin.js",
    "plugin/build/**",
    "scripts/hermes-sourcemaps.js",
    "scripts/compose-then-inject.js",
    "scripts/bugsee-xcode.sh",
    "scripts/hermesc-preserve-js.sh",
    "scripts/bugsee-sourcemaps.gradle",
    "react-native.config.js",
    "*.podspec",
    "native-versions.json"
  ],
  "dependencies": {
    "@bugsee/cli": "0.7.11",
    "@expo/config-plugins": "~57.0.9"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.81.0"
  },
  "devDependencies": {
    "react-native": "0.87.1"
  },
  "scripts": {
    "build:plugin": "node ../../node_modules/typescript/lib/tsc.js -p plugin/tsconfig.json && node plugin/bake-native-versions.js",
    "prepack": "node ../../scripts/cli-check-releasable-pins.ts && node ../../scripts/cli-pack-native-versions.ts stage",
    "postpack": "node ../../scripts/cli-pack-native-versions.ts unstage"
  },
  "codegenConfig": {
    "name": "RNBugseeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.bugsee.reactnative"
    },
    "ios": {
      "modulesProvider": {
        "Bugsee": "BugseeModule"
      }
    }
  }
}
