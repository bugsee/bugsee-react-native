{
  "name": "@bugsee/react-native-feedback",
  "version": "7.0.0-beta1",
  "description": "In-app feedback UI for the Bugsee React Native SDK",
  "license": "MIT",
  "homepage": "https://www.bugsee.com",
  "main": "src/index.ts",
  "files": [
    "src",
    "!src/**/__tests__",
    "!src/testSupport",
    "android",
    "!android/src/test",
    "ios",
    "react-native.config.js",
    "*.podspec",
    "native-versions.json",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "@bugsee/react-native": "^7.0.0-beta1",
    "react": "*",
    "react-native": ">=0.81.0"
  },
  "devDependencies": {
    "react-native": "0.87.1"
  },
  "scripts": {
    "prepack": "node ../../scripts/cli-check-releasable-pins.ts && node ../../scripts/cli-pack-native-versions.ts stage",
    "postpack": "node ../../scripts/cli-pack-native-versions.ts unstage"
  },
  "codegenConfig": {
    "name": "RNBugseeFeedbackSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.bugsee.reactnative.feedback"
    },
    "ios": {
      "modulesProvider": {
        "BugseeFeedbackModule": "BugseeFeedbackModule"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bugsee/bugsee-react-native.git",
    "directory": "packages/react-native-feedback"
  },
  "publishConfig": {
    "access": "public"
  }
}
