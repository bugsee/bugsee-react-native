{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "yarn",
  "testRunner": "jest",
  "concurrency": 3,
  "jest": {
    "projectType": "custom",
    "configFile": "package.json",
    "config": {
      "roots": ["<rootDir>/scripts"],
      "testMatch": [
        "<rootDir>/scripts/__tests__/**/*.test.ts"
      ],
      "transform": {
        "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.mutation.json", "diagnostics": false }]
      }
    }
  },
  "reporters": [
    "clear-text",
    "progress"
  ],
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "mutate": [
    "scripts/**/*.ts",
    "!scripts/cli-*.ts",
    "!**/__tests__/**"
  ],
  "thresholds": {
    "high": 95,
    "low": 85,
    "break": 85
  },
  "timeoutMS": 30000,
  "ignorePatterns": [
    "examples",
    "**/Pods/**",
    "**/*.xcframework/**",
    "**/build/**",
    "**/.build/**",
    "**/DerivedData/**",
    ".stryker-tmp",
    "**/.gradle/**"
  ]
}
