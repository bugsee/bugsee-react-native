node_modules/
.yarn/*
!.yarn/patches
!.yarn/releases
.turbo/
lib/
dist/
coverage/
*.log
.DS_Store

# Native build output. `build/` would also hide the compiled Expo config
# plugin, which ships in the package, so that directory is un-ignored below.
android/build/
android/.gradle/
ios/build/
ios/.swiftpm/
*.xcworkspace/xcuserdata/
Pods/

# Never commit credentials
bugsee.properties
.env
.gradle/
local.properties
**/build/**
!packages/react-native/plugin/build/**
.build/
.swiftpm/
*.xcodeproj/
# ...except an example app's, which is a real, hand-maintained project and has
# to be checked in for anyone to build it. Re-including the excluded directory
# itself works; re-including a file under an excluded parent would not.
!examples/*/ios/*.xcodeproj/

# Downloaded by the podspec's prepare_command, not authored here.
packages/react-native/Bugsee.xcframework/
packages/react-native-feedback/BugseeFeedbackSources/

.stryker-tmp/
reports/
packages/react-native/.bugsee-xcframework-version
packages/react-native-feedback/.bugsee-feedback-sources-version
examples/*/ios/build-spm/
# `lib/` above is for build output; these are campaign generator steps.
!scripts/campaign/lib/
