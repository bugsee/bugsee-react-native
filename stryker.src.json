{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "yarn",
  "testRunner": "jest",
  "concurrency": 3,
  "jest": {
    "projectType": "custom",
    "configFile": "package.json",
    "config": {
      "roots": ["<rootDir>/packages/react-native/src", "<rootDir>/scripts"],
      "testMatch": [
        "<rootDir>/packages/react-native/src/**/__tests__/**/*.test.ts?(x)",
        "<rootDir>/scripts/__tests__/option-manifest-parity.test.ts"
      ],
      "transform": {
        "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.mutation.json", "diagnostics": false }]
      }
    }
  },
  "reporters": [
    "clear-text",
    "progress"
  ],
  "coverageAnalysis": "perTest",
  "mutate": [
    "packages/react-native/src/**/*.ts",
    "packages/react-native/src/**/*.tsx",
    "!**/__tests__/**",
    "!**/__mocks__/**"
  ],
  "thresholds": {
    "high": 100,
    "low": 95,
    "break": 95
  },
  "timeoutMS": 30000,
  "ignorePatterns": [
    "examples",
    "**/Pods/**",
    "**/*.xcframework/**",
    "**/build/**",
    "**/.build/**",
    "**/DerivedData/**",
    ".stryker-tmp",
    "**/.gradle/**"
  ]
}
