{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // RN 0.87 sets exports["./Libraries/*"].types to null, so deep imports
    // into react-native resolve to .js with no declarations. This condition is
    // RN's own sanctioned opt-in to the typed deep-import surface, which is
    // where codegen types such as UnsafeObject live.
    "customConditions": ["react-native-legacy-deep-imports"],
    // <BugseeSecure> is the library's first .tsx; the automatic runtime is
    // what React Native's Babel preset compiles it with.
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true
  }
}
