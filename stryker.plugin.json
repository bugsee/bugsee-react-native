{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "yarn",
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "package.json",
    "config": {
      "roots": ["<rootDir>/packages/react-native"],
      "testMatch": [
        "<rootDir>/packages/react-native/plugin/src/__tests__/**/*.test.ts",
        "<rootDir>/packages/react-native/scripts/__tests__/**/*.test.js"
      ],
      "transform": {
        "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.mutation.json", "diagnostics": false }]
      }
    }
  },
  "reporters": [
    "clear-text",
    "progress"
  ],
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "mutate": [
    "packages/react-native/plugin/src/**/*.ts",
    "packages/react-native/scripts/hermes-sourcemaps.js",
    "packages/react-native/scripts/compose-then-inject.js",
    "packages/react-native/scripts/hermesc-preserve-js.js",
    "!**/__tests__/**"
  ],
  "thresholds": {
    "high": 100,
    "low": 97,
    "break": 97
  },
  "timeoutMS": 15000,
  "inPlace": true,
  "tempDirName": ".stryker-tmp",
  "disableTypeChecks": "packages/react-native/plugin/src/**/*.ts",
  "concurrency": 3
}
